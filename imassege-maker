<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iPhone Emergency Alert</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: #e5e5e5;
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', sans-serif;
        }

        .iphone {
            width: 390px;
            height: 844px;
            background: #1c1c1e;
            border-radius: 55px;
            position: relative;
            overflow: hidden;
            /* Physical bezel */
            border: 14px solid #000;
        }

        /* Power button */
        .iphone::before {
            content: '';
            position: absolute;
            right: -14px;
            top: 180px;
            width: 4px;
            height: 80px;
            background: #000;
            border-radius: 0 2px 2px 0;
        }

        /* Volume buttons */
        .iphone::after {
            content: '';
            position: absolute;
            left: -14px;
            top: 120px;
            width: 4px;
            height: 45px;
            background: #000;
            border-radius: 2px 0 0 2px;
        }

        .volume-down {
            position: absolute;
            left: -14px;
            top: 180px;
            width: 4px;
            height: 45px;
            background: #000;
            border-radius: 2px 0 0 2px;
        }

        .mute-switch {
            position: absolute;
            left: -14px;
            top: 90px;
            width: 3px;
            height: 25px;
            background: #000;
            border-radius: 2px 0 0 2px;
        }

        /* Dynamic Island */
        .dynamic-island {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 126px;
            height: 37px;
            background: #000;
            border-radius: 19px;
            z-index: 1000;
        }

        /* Status Bar */
        .status-bar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 54px;
            padding: 0 33px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            z-index: 999;
            padding-top: 8px;
        }

        .status-left {
            display: flex;
            align-items: center;
            gap: 4px;
            margin-left: -10px;
        }

        .status-right {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-right: -10px;
        }

        .signal-bars {
            display: flex;
            gap: 2px;
            align-items: flex-end;
            height: 12px;
        }

        .signal-bars span {
            width: 3px;
            background: #fff;
            border-radius: 1px;
        }

        .signal-bars span:nth-child(1) { height: 4px; }
        .signal-bars span:nth-child(2) { height: 7px; }
        .signal-bars span:nth-child(3) { height: 10px; }
        .signal-bars span:nth-child(4) { height: 12px; }

        .wifi-icon {
            font-size: 16px;
        }

        .battery {
            display: flex;
            align-items: center;
            gap: 2px;
        }

        .battery-icon {
            width: 27px;
            height: 13px;
            border: 2px solid #fff;
            border-radius: 3px;
            position: relative;
            display: flex;
            align-items: center;
            padding: 2px;
        }

        .battery-icon::after {
            content: '';
            position: absolute;
            right: -4px;
            top: 50%;
            transform: translateY(-50%);
            width: 2px;
            height: 6px;
            background: #fff;
            border-radius: 0 1px 1px 0;
        }

        .battery-fill {
            width: 85%;
            height: 100%;
            background: #fff;
            border-radius: 1px;
        }

        .battery-percent {
            font-size: 15px;
        }

        /* Lock Screen Content */
        .lockscreen {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            padding-top: 80px;
        }

        .time-date {
            text-align: center;
            color: #fff;
            padding: 0 30px;
        }

        .time {
            font-size: 80px;
            font-weight: 300;
            letter-spacing: -1px;
            선 높이: 1;
            마진-바닥: 8px;
        }

        .date {
            font-size: 18px;
            font-weight: 500;
            color: rgba(255,255,255,0.8);
        }

        /* Emergency Alert */
        .notification-area {
            flex: 1;
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .emergency-alert {
            background: rgba(28, 28, 30, 0.95);
            border-radius: 20px;
            padding: 16px;
            border: 1px solid rgba(255,255,255,0.1);
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        .emergency-alert:active {
            transform: scale(0.98);
            background: rgba(28, 28, 30, 1);
        }

        .alert-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .alert-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #ff3b30, #ff6b6b);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .alert-title {
            flex: 1;
        }

        .alert-app-name {
            font-size: 13px;
            font-weight: 600;
            color: rgba(255,255,255,0.7);
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .alert-time {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
            margin-top: 1px;
        }

        .alert-subject {
            font-size: 15px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 8px;
        }

        .alert-message {
            font-size: 14px;
            line-height: 1.45;
            color: rgba(255,255,255,0.85);
            font-weight: 400;
        }

        /* Bottom Indicator */
        .bottom-bar {
            position: absolute;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: 140px;
            height: 5px;
            background: rgba(255,255,255,0.3);
            border-radius: 3px;
        }
    </style>
</head>
<body>
    <div class="iphone">
        <!-- Side buttons -->
        <div class="volume-down"></div>
        <div class="mute-switch"></div>
        
        <!-- Dynamic Island -->
        <div class="dynamic-island"></div>
        
        <!-- Status Bar -->
        <div class="status-bar">
            <div class="status-left">
                <div class="signal-bars">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <span style="font-size: 15px; margin-left: 4px;">5G</span>
            </div>
            <div class="status-right">
                <div class="battery">
                    <span class="battery-percent">73%</span>
                    <div class="battery-icon">
                        <div class="battery-fill"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lock Screen -->
        <div class="lockscreen">
            <div class="time-date">
                <div class="time">19:24</div>
                <div class="date">2월 16일 월요일</div>
            </div>

            <div class="notification-area">
                <div class="emergency-alert">
                    <div class="alert-header">
                        <div class="alert-icon">⚠️</div>
                        <div class="alert-title">
                            <div class="alert-app-name">긴급재난문자</div>
                            <div class="alert-time">방금 전</div>
                        </div>
                    </div>
                    <div class="alert-subject">[행정안전부] 긴급 안전 안내</div>
                    <div class="alert-message">
                        원인 불명 '광증 안개' 전국 확산, 외출 즉시 중단 및 밀폐 공간 대피 바랍니다. 안개 노출자 접근 금지, 이상 행동 발견 시 112·119 즉시 신고하십시오.
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div class="하"></div>
    </div>

    <script>
        // Update time every second
        function updateTime() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            document.querySelector('.time').textContent = `${hours}:${minutes}`;
        }
        
        updateTime();
        setInterval(updateTime, 1000);

        // Add touch feedback to notification
        const alert = document.querySelector('.emergency-alert');
        
        alert.addEventListener('touchstart', function(e) {
            this.style.transform = 'scale(0.98)';
            this.style.background = 'rgba(28, 28, 30, 0.95)';
        });
        
        alert.addEventListener('touchend', function(e) {
            setTimeout(() => {
                this.style.transform = 'scale(1)';
                this.style.background = 'rgba(28, 28, 30, 0.85)';
            }, 100);
        });

        // Mouse events for desktop preview
        alert.addEventListener('mousedown', function(e) {
            this.style.transform = 'scale(0.98)';
            this.style.background = 'rgba(28, 28, 30, 0.95)';
        });
        
        alert.addEventListener('mouseup', function(e) {
            setTimeout(() => {
                this.style.transform = 'scale(1)';
                this.style.background = 'rgba(28, 28, 30, 0.85)';
            }, 100);
        });
        
        alert.addEventListener('mouseleave', function(e) {
            this.style.transform = 'scale(1)';
            this.style.background = 'rgba(28, 28, 30, 0.85)';
        });
    </script>
</body>
</html>
